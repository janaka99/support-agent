# ==============================================================================
# Database Configuration
# ==============================================================================
# For Local All-in-One Docker Compose (infra/docker-compose.yml):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=support_agent
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_agent

# For Production (infra/docker-compose.prod.yml with AWS RDS / Supabase / Neon):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[MANAGED_HOST]:5432/postgres?sslmode=require

# ==============================================================================
# Redis Configuration
# ==============================================================================
# For Local Docker Compose:
REDIS_URL=redis://localhost:6379/0

# For Production (AWS ElastiCache / Upstash / Redis Cloud):
# REDIS_URL=rediss://default:[PASSWORD]@[MANAGED_REDIS_HOST]:6379/0

# ==============================================================================
# Application Secrets & LLM API Keys
# ==============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
SECRET_KEY=generate_a_secure_random_string_for_jwt_auth

# ==============================================================================
# Frontend & CORS Configuration
# ==============================================================================
# Public API URL consumed by the Next.js browser client
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# Observability / Langfuse (Optional)
# ==============================================================================
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
